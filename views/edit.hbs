<div class="w-75 mx-auto">
  <p class="fs-1">Edit product</p>
  {{#if editError}}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <strong>Error! </strong>{{editError}}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {{/if}}

  <form action="/product/{{product._id}}/edit" method="post" enctype="multipart/form-data">
    <div class="form-floating mb-3">
      <input type="text" class="form-control" id="floatingInput" placeholder="title" name="title" value="{{product.title}}" />
      <label for="floatingInput">Title</label>
    </div>
    <div class="form-floating mb-3">
      <textarea
        class="form-control"
        placeholder="Description"
        id="floatingTextarea2"
        name="description"
        style="height: 100px"
      >{{product.description}}</textarea>
      <label for="floatingTextarea2">Description</label>
    </div>
    <div class="input-group mb-3">
      <div class="label-container">
        <label class="text fs-5 mr-2 mt-1">Current Image</label>
      </div>
      <div class="input-container">
        {{#if product.image}}
          <div class="mb-2"><img src="/uploads/{{product.image}}" style="max-width:200px;"/></div>
        {{/if}}
        <input type="file" name="image" />
      </div>
      <div class="image error"></div>
    </div>

    <div class="input-group mb-3">
      <label for="category" class="text fs-5 mr-2 mt-1">Category</label>
      <select
        id="category"
        class="form-select"
        aria-label="Default select example"
        style="margin-left: 10px;"
        name="category"
      >
  <option value="food" {{#if isFood}}selected{{/if}}>Food</option>
  <option value="drinks" {{#if isDrinks}}selected{{/if}}>Drinks</option>
  <option value="other" {{#if isOther}}selected{{/if}}>Other</option>
      </select>
    </div>

    <div class="input-group mb-3">
      <span class="input-group-text">$</span>
      <div class="form-floating">
        <input
          type="number"
          class="form-control"
          name="price"
          id="floatingInputGroup1"
          placeholder="Price"
          value="{{product.price}}"
        />
        <label for="floatingInputGroup1">Price</label>
      </div>
    </div>
    <button class="btn btn-primary mt-3">Update</button>
  </form>
</div>
